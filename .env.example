# =============================================================
#  Multi-Source RAG App — Environment Configuration
#  Copy this file to .env and fill in your values.
#  All providers have a free default — only fill what you use.
# =============================================================

# ----------------------------
# LLM PROVIDER
# Options: groq | gemini | openai | ollama
# Default (free): groq
# ----------------------------
LLM_PROVIDER=groq

GROQ_API_KEY=your_groq_api_key_here          # Free — https://console.groq.com
GROQ_MODEL=llama-3.1-8b-instant              # or: llama-3.3-70b-versatile, gemma2-9b-it

GOOGLE_API_KEY=your_google_api_key_here      # Free tier — https://aistudio.google.com
GEMINI_MODEL=gemini-1.5-flash                # or: gemini-1.5-pro

OPENAI_API_KEY=your_openai_api_key_here      # Paid — https://platform.openai.com
OPENAI_MODEL=gpt-4o-mini                     # or: gpt-4o, gpt-3.5-turbo

OLLAMA_BASE_URL=http://localhost:11434       # Local — https://ollama.ai
OLLAMA_MODEL=llama3                          # Any model pulled via `ollama pull`

# ----------------------------
# EMBEDDING PROVIDER
# Options: huggingface | openai | ollama | gemini
# Default (free, local): huggingface
# ----------------------------
EMBEDDING_PROVIDER=huggingface

HUGGINGFACE_EMBEDDING_MODEL=all-MiniLM-L6-v2          # Lighter (~80MB), good quality
# Other good free options:
# all-MiniLM-L6-v2  (faster, slightly less accurate)
# BAAI/bge-large-en-v1.5  (more accurate, slower)

OPENAI_EMBEDDING_MODEL=text-embedding-3-small         # Paid

OLLAMA_EMBEDDING_MODEL=nomic-embed-text               # Free local

# ----------------------------
# VECTOR STORE
# Options: chroma | qdrant | pinecone
# Default (free, local): chroma
# ----------------------------
VECTOR_STORE=chroma

CHROMA_PERSIST_DIR=./data/chroma_db                  # Local persistence path

QDRANT_URL=http://localhost:6333                      # Local Qdrant instance
QDRANT_API_KEY=                                       # Only needed for Qdrant Cloud
QDRANT_COLLECTION=rag_documents

PINECONE_API_KEY=your_pinecone_api_key_here           # Free tier available
PINECONE_INDEX=rag-index
PINECONE_ENVIRONMENT=us-east-1-aws

# ----------------------------
# WEB SEARCH PROVIDER
# Options: duckduckgo | tavily | serpapi
# Default (free, no key needed): duckduckgo
# ----------------------------
WEB_SEARCH_PROVIDER=duckduckgo

TAVILY_API_KEY=your_tavily_api_key_here               # Free tier: 1000 searches/month
SERPAPI_API_KEY=your_serpapi_api_key_here             # Paid

WEB_SEARCH_MAX_RESULTS=5

# ----------------------------
# GITHUB SOURCE (optional)
# ----------------------------
GITHUB_TOKEN=your_github_personal_access_token        # Optional, increases rate limit

# ----------------------------
# APP SETTINGS
# ----------------------------
APP_NAME="Multi-Source RAG"
DEBUG=false
MAX_CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RESULTS=5                                       # Number of docs to retrieve
TEMPERATURE=0.1                                       # LLM temperature (0 = deterministic)
